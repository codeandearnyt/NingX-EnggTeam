{
  "description": "NingX-EnggTeam enforcement hooks. PreToolUse on Edit/Write/MultiEdit runs ui-guard.py, which blocks writes that violate the ten non-negotiables.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ui-guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/ui-guard.py\"",
            "timeout": 15,
            "description": "Block writes that break the ten non-negotiables"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-brief.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-brief.py\"",
            "timeout": 10,
            "description": "Print the team roster and the 24-type index at session start"
          }
        ]
      }
    ]
  }
}
